{
  "name": "@gendev/ts-tour",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "tsc && concurrently --kill-others --raw \"tsc --watch --preserveWatchOutput\" \"node --watch dist/app.js\"",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@gendev/example-runner": "workspace:*",
    "@gendev/ts-examples": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "concurrently": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:"
  }
}
