{
  "name": "@wp/server",
  "packageManager": "yarn@4.10.3",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node ./dist/server.js",
    "start-preload": "node ./dist/server.js --preload",
    "serve": "node --watch ./dist/server.js",
    "serve-preload": "node --watch ./dist/server.js --preload"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "express": "^5.1.0",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.34.4",
    "socket.io": "^4.8.1",
    "tsyringe": "^4.10.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.5.2",
    "@types/reflect-metadata": "^0.1.0",
    "typescript": "^5.9.2"
  }
}
