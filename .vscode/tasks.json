{
  "version": "2.0.0",
  "type": "shell",
  "group": "build",
  "problemMatcher": "$tsc",
  "presentation": {
    "echo": true,
    "reveal": "silent",
    "focus": false,
    "panel": "shared",
    "showReuseMessage": true,
    "clear": false
  },
  "tasks": [
    {
      "label": "Build all",
      "command": "pnpm build",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Build cli-demo",
      "command": "pnpm --filter @gendev/cli-demo... build"
    },
    {
      "label": "Build princess",
      "command": "pnpm --filter @gendev/princess... build"
    },
    {
      "label": "Build ts-tour",
      "command": "pnpm --filter @gendev/ts-tour... build"
    }
  ]
}
