{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug @demos/yarn",
      "request": "launch",
      "runtimeArgs": ["workspace", "@demos/yarn", "start"],
      "runtimeExecutable": "yarn",
      "type": "node",
      "console": "integratedTerminal",
      "preLaunchTask": "Build @demos/yarn"
    },
    {
      "name": "Debug @demos/examples",
      "request": "launch",
      "runtimeArgs": ["workspace", "@demos/examples", "start"],
      "runtimeExecutable": "yarn",
      "type": "node",
      "console": "integratedTerminal",
      "preLaunchTask": "Build @demos/node"
    },
    {
      "name": "Debug @cli/demo",
      "program": "${workspaceFolder}/apps/@cli/demo/dist/main.js",
      "request": "launch",
      "skipFiles": ["<node_internals>/**"],
      "type": "node",
      "console": "integratedTerminal",
      "preLaunchTask": "Build @cli/demo",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///./~/*": "${workspaceFolder}/node_modules/*",
        "webpack://?:*/*": "${workspaceFolder}/*"
      }
    },
    {
      "name": "Debug @cli/princess",
      "program": "${workspaceFolder}/apps/@cli/princess/dist/main.js",
      "request": "launch",
      "skipFiles": ["<node_internals>/**"],
      "type": "node",
      "console": "integratedTerminal",
      "preLaunchTask": "Build @cli/princess",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///./~/*": "${workspaceFolder}/node_modules/*",
        "webpack://?:*/*": "${workspaceFolder}/*"
      }
    }
  ]
}
