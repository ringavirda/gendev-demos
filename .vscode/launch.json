{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug @demos/yarn",
      "request": "launch",
      "runtimeArgs": ["workspace", "@demos/yarn", "start"],
      "runtimeExecutable": "yarn",
      "type": "node",
      "console": "integratedTerminal",
      "preLaunchTask": "Build @demos/yarn"
    },
    {
      "name": "Debug @demos/examples",
      "request": "launch",
      "runtimeArgs": ["workspace", "@demos/examples", "start"],
      "runtimeExecutable": "yarn",
      "type": "node",
      "console": "integratedTerminal",
      "preLaunchTask": "Build @demos/examples"
    },
    {
      "name": "Debug @cli/demo",
      "request": "launch",
      "runtimeArgs": ["workspace", "@cli/demo", "start"],
      "runtimeExecutable": "yarn",
      "type": "node",
      "console": "integratedTerminal",
      "preLaunchTask": "Build @cli/demo"
    },
    {
      "name": "Debug @cli/princess",
      "request": "launch",
      "runtimeArgs": ["workspace", "@cli/princess", "start"],
      "runtimeExecutable": "yarn",
      "type": "node",
      "console": "integratedTerminal",
      "preLaunchTask": "Build @cli/princess",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///./~/*": "${workspaceFolder}/node_modules/*",
        "webpack://?:*/*": "${workspaceFolder}/*"
      }
    }
  ]
}
