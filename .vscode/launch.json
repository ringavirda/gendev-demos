{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug node-console",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/apps/node-console/src/app.js",
      "cwd": "${workspaceFolder}/apps/node-console",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/{apps,packages}/*/dist/**/*.js"],
      "args": ["${input:example}"]
    },
    {
      "name": "Debug cli-demo",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/apps/cli-demo/dist/app.js",
      "cwd": "${workspaceFolder}/apps/cli-demo",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/{apps,packages}/*/dist/**/*.js"],
      "preLaunchTask": "Build cli-demo"
    },
    {
      "name": "Debug princess",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/apps/princess/dist/app.js",
      "cwd": "${workspaceFolder}/apps/princess",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/{apps,packages}/*/dist/**/*.js"],
      "preLaunchTask": "Build princess"
    },
    {
      "name": "Debug ts-tour",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/apps/ts-tour/dist/app.js",
      "cwd": "${workspaceFolder}/apps/ts-tour",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/{apps,packages}/*/dist/**/*.js"],
      "args": ["${input:topic}"],
      "preLaunchTask": "Build ts-tour"
    },
    {
      "name": "Debug ts7",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/apps/ts7/dist/app.js",
      "cwd": "${workspaceFolder}/apps/ts7",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/apps/ts7/dist/**/*.js"],
      "preLaunchTask": "Build ts7"
    },
    {
      "name": "Debug ts7 compare",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/apps/ts7/scripts/compare.js",
      "cwd": "${workspaceFolder}/apps/ts7",
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "example",
      "type": "pickString",
      "description": "Example",
      "options": [
        "stdin-events",
        "readline-question",
        "readline-events",
        "readline-for-await",
        "emitter-events",
        "emitter-promise",
        "fs-callbacks",
        "fs-promises",
        "selector"
      ],
      "default": "stdin-events"
    },
    {
      "id": "topic",
      "type": "pickString",
      "description": "Topic",
      "options": [
        "typing",
        "narrowing",
        "generics",
        "paradigms",
        "classes",
        "inheritance",
        "polymorphism",
        "linked-list",
        "decorators",
        "std-decorators",
        "type-level",
        "all"
      ],
      "default": "all"
    }
  ]
}
