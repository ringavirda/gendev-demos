{
  "name": "demos-gendev",
  "packageManager": "yarn@4.10.3",
  "type": "module",
  "scripts": {
    "build-all": "yarn workspaces foreach -v run build",
    "clean": "rimraf dist"
  },
  "workspaces": [
    "apps/*",
    "apps/@cli/*",
    "apps/@wp/*",
    "packages/*",
    "packages/@cli/*",
    "packages/@wp/*"
  ],
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.5.2",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1"
  }
}
